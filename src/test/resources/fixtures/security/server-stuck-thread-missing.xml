<?xml version="1.0" encoding="UTF-8" ?>
<Server port="-1" shutdown="SHUTDOWN">
    <Service name="Catalina">

        <Engine name="Catalina"
                defaultHost="localhost"
                backgroundProcessorDelay="600">

            <Host name="localhost"
                  appBase="webapps"
                  unpackWARs="true"
                  autoDeploy="true">
            </Host>

        </Engine>

    </Service>
</Server>